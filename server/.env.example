# ---- Core ----
PORT=3000
# Token the dashboard/API requires (put the same value into the dashboard login screen on your phone).
DASHBOARD_TOKEN=change-me-to-a-long-random-string

# ---- Claude (content generation & auto-reply drafting) ----
ANTHROPIC_API_KEY=
# Subscription tier: basic | premium | vip (see server/src/lib/plans.ts)
PLAN_TIER=vip
# Override of the tier's monthly Claude-call allowance. 0 = use the tier. Usage: GET /api/usage
AI_MONTHLY_LIMIT=0
# Brand voice / business description for Claude. Empty = built-in ROCCA voice; set it to run the bot for another business.
BRAND_VOICE=

# ---- Meta (Facebook Page + Instagram Business account), via Meta Business Suite / developers.facebook.com ----
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_IG_USER_ID=
META_APP_ID=
META_APP_SECRET=
# Any string you choose; must match what you enter in the Meta App webhook subscription screen.
META_WEBHOOK_VERIFY_TOKEN=change-me-too

# ---- X (Twitter) — developer.twitter.com, needs a user-context app (OAuth 1.0a keys) ----
X_APP_KEY=
X_APP_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# ---- TikTok (Content Posting API) — developers.tiktok.com, requires app audit before public posting ----
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=

# ---- Website updates ----
# Path to the repo checkout that contains content/updates.json + index.html. ".." = the parent of this server/ folder.
WEBSITE_REPO_PATH=..
# When true, the bot runs `git add/commit/push` after writing a website update. Leave false until you're ready.
AUTO_GIT_PUSH=false

# ---- Auto-reply behavior ----
# When true, replies Claude drafts for comments/DMs/mentions are sent immediately.
# When false (recommended to start), they wait in the dashboard for you to approve.
AUTO_SEND_REPLIES=false

# How often (minutes) to poll X for new mentions (X has no push webhooks on the free/basic tiers).
X_MENTIONS_POLL_MINUTES=15
# Top-up packs: payment-page URLs from your payment provider, and the secret its webhook sends (header x-webhook-secret)
PACK_LINK_SMALL=
PACK_LINK_MEDIUM=
PACK_LINK_LARGE=
PAYMENT_WEBHOOK_SECRET=
# Persistent storage (Postgres connection string, e.g. from a free Neon project). Empty = local files, lost on Render restart.
DATABASE_URL=
# "Connect with Facebook": Meta app credentials (Meta app > Settings > Basic) and this server's public URL
META_APP_ID=
META_APP_SECRET=
PUBLIC_URL=https://rocca-social-bot.onrender.com
# Facebook Login for Business: the Configuration ID (Meta app > Facebook Login for Business > Configurations)
META_LOGIN_CONFIG_ID=
# true on customer deployments: require the business setup (Settings tab) before generating content
REQUIRE_PROFILE=false
# Optional second model (Gemini, Google AI Studio key). Empty key = Claude only.
GEMINI_API_KEY=
# Leave empty: the app finds the newest Flash model your key can use. Set only to force a specific model.
GEMINI_MODEL=
# Optional: tiers that use Gemini even for heavy tasks, e.g. basic. AI_PROVIDER=gemini forces Gemini for everyone.
# Default routing: Gemini = posts and replies; Claude = plans, campaigns, strategy, brand voice. Users can pick a model in the app.
GEMINI_FOR_TIERS=
AI_PROVIDER=
# Legal pages: who operates the service and the contact email shown in /legal/*
OPERATOR_NAME=
CONTACT_EMAIL=

# --- Multi-tenant (many businesses in one deployment) ---
# closed (default): only the operator uses it  |  invite: sign-up needs a code from the admin tab  |  open: anyone can sign up (30-day trial)
SIGNUP_MODE=closed

# --- BOOL platform ---
# Public key of the original business on /api/leads/capture (landing pages / ad lead forms post it with each lead)
LEAD_KEY=
# Payment: hosted payment-page link per product (from your Israeli clearing provider), and the secret the provider's webhook sends
PAYMENT_WEBHOOK_SECRET=
CHECKOUT_SECRET=
# CHECKOUT_LINK_CREDITS_10= CHECKOUT_LINK_CREDITS_35= CHECKOUT_LINK_CREATOR_WEEKLY= CHECKOUT_LINK_CREATOR_LITE_MONTHLY= CHECKOUT_LINK_CREATOR_PRO_MONTHLY=
# CHECKOUT_LINK_STARTER_SOCIAL_MONTHLY= CHECKOUT_LINK_CORE_PRESENCE_ANNUAL= CHECKOUT_LINK_DIGITAL_PRO_ANNUAL= CHECKOUT_LINK_TOTAL_DOMINANCE_ANNUAL=
PRICES_VAT_NOTE="המחירים כוללים מע״מ כחוק"
# Catalog prices are before VAT; screens show "כולל מע״מ: ₪X" computed with this rate (default 0.18)
VAT_RATE=0.18
# gross (default): the prominent price includes VAT, with a small breakdown line  |  net: base price first
PRICE_DISPLAY=gross
# Lead notifications: email via Resend and/or a webhook (Make/Zapier/WhatsApp relay)
RESEND_API_KEY=
NOTIFY_FROM=
LEAD_WEBHOOK_URL=
# Domains
PUBLIC_URL=
CORS_ORIGINS=
# Credit link in generated sites: true adds rel="nofollow" (recommended if many sites link to rocca.co.il)
BOOL_CREDIT_NOFOLLOW=false
# AI_MOCK=1 is for automated tests only
